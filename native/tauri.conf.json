{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Games Collection",
    "version": "2.5.0",
    "identifier": "ai.fleet.games-app",
    "build": {
        "frontendDist": "../web_sota/dist",
        "devUrl": "http://localhost:10986",
        "beforeDevCommand": "npm --prefix ../web_sota run dev",
        "beforeBuildCommand": "npm --prefix ../web_sota run build"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "Games Collection",
                "width": 1280,
                "height": 860,
                "minWidth": 900,
                "minHeight": 600,
                "resizable": true
            }
        ],
        "security": {
            "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:10987 ipc: http://ipc.localhost; img-src 'self' data: http://127.0.0.1:10987; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
        }
    },
    "bundle": {
        "active": true,
        "targets": ["nsis"],
        "icon": ["icons/icon.png", "icons/icon.ico"],
        "resources": [
            "resources/games-app-backend.exe",
            "resources/.env",
            "../web_sota/dist/**"
        ],
        "windows": {
            "webviewInstallMode": {
                "type": "skip"
            },
            "nsis": {
                "installerHooks": "./windows/hooks.nsh",
                "installMode": "currentUser"
}
        }
    },
    "plugins": {
        "shell": {
            "open": true
        },
        "fs": {
            "requireLiteralLeadingDot": false
        },
        "process": {
            "all": true
        }
    }
}



{
  "name": "ai-games-collection-mcp",
  "description": "SOTA AI Games Collection MCP Server - Complete chess, Go, Shogi analysis and game management via Claude/Cursor",
  "version": "0.1.0",
  "author": "FlowEngineer",
  "repository": "https://github.com/sandraschi/ai-games-collection",
  "license": "MIT",

  "language": "python",
  "framework": "fastmcp",

  "review": {
    "enabled": true,
    "scope": ["src/", "tests/"],
    "exclude": ["__pycache__/", "*.pyc", ".git/"],
    "rules": {
      "security": {
        "enabled": true,
        "level": "high",
        "checks": [
          "sql_injection",
          "command_injection",
          "path_traversal",
          "unsafe_deserialization",
          "weak_crypto",
          "hardcoded_secrets"
        ]
      },
      "performance": {
        "enabled": true,
        "level": "medium",
        "checks": [
          "inefficient_loops",
          "memory_leaks",
          "blocking_operations",
          "large_objects",
          "database_optimization"
        ]
      },
      "maintainability": {
        "enabled": true,
        "level": "medium",
        "checks": [
          "code_complexity",
          "duplicate_code",
          "long_functions",
          "missing_docstrings",
          "inconsistent_naming",
          "circular_imports"
        ]
      },
      "reliability": {
        "enabled": true,
        "level": "high",
        "checks": [
          "error_handling",
          "race_conditions",
          "resource_cleanup",
          "timeout_handling",
          "graceful_degradation"
        ]
      }
    }
  },

  "documentation": {
    "enabled": true,
    "auto_generate": true,
    "format": "markdown",
    "include": {
      "api_reference": true,
      "usage_examples": true,
      "architecture_diagram": true,
      "changelog": true
    },
    "style": {
      "language": "english",
      "technical_level": "intermediate",
      "include_code_examples": true,
      "generate_diagrams": true
    }
  },

  "testing": {
    "enabled": true,
    "framework": "pytest",
    "coverage": {
      "enabled": true,
      "minimum": 80,
      "report_format": ["html", "xml"]
    },
    "types": {
      "unit": true,
      "integration": true,
      "performance": false,
      "security": false
    }
  },

  "code_quality": {
    "enabled": true,
    "linter": "ruff",
    "formatter": "ruff",
    "type_checker": "mypy",
    "rules": {
      "max_line_length": 88,
      "max_function_length": 50,
      "max_class_length": 300,
      "max_complexity": 10
    }
  },

  "mcp_specific": {
    "server_type": "tool_server",
    "protocol_version": "2024-11-05",
    "capabilities": [
      "tools",
      "resources",
      "prompts"
    ],
    "tool_count": 16,
    "features": [
      "chess_analysis",
      "go_analysis",
      "shogi_analysis",
      "tournament_management",
      "database_persistence",
      "adn_integration"
    ]
  },

  "dependencies": {
    "runtime": [
      "fastmcp>=0.9.0",
      "aiohttp>=3.8.0",
      "pydantic>=2.0.0",
      "sqlite3"
    ],
    "development": [
      "pytest>=7.0.0",
      "ruff>=0.1.0",
      "mypy>=1.0.0",
      "pytest-cov"
    ]
  },

  "build_system": {
    "type": "setuptools",
    "package_name": "ai_games_collection_mcp",
    "entry_points": {
      "console_scripts": [
        "ai-games-collection-mcp = ai_games_collection_mcp.mcp_server:main"
      ]
    }
  },

  "ai_assistance": {
    "code_generation": {
      "enabled": true,
      "style": "modern_python",
      "patterns": ["async_await", "type_hints", "dataclasses"]
    },
    "code_review": {
      "enabled": true,
      "focus_areas": ["security", "performance", "maintainability"]
    },
    "documentation": {
      "enabled": true,
      "auto_update": true,
      "include_examples": true
    }
  }
}
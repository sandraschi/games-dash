# Server Configuration
# Copy this file to .env and adjust values as needed

# Kanji API Server
KANJI_API_PORT=5003
KANJI_DB_PATH=../data/kanji.db

# JLPT API Server
JLPT_API_PORT=5001
JLPT_DB_PATH=../data/jlpt_questions.db

# General Server Settings
DEBUG_MODE=True
HOST=0.0.0.0

# MCP Bridge: proxy tools from remote MCP servers
# Comma-separated list of MCP server URLs to bridge into this server
# MCP_BRIDGE_URLS=http://127.0.0.1:10801/mcp,http://127.0.0.1:10803/mcp

{
  "$schema": "https://glama.ai/mcp/schemas/server.json",
  "name": "games-mcp",
  "version": "2.5.1",
  "description": "SOTA Games MCP Server - 150+ browser games, AI engine integration (Stockfish/KataGo/YaneuraOu), Japanese learning, P2P multiplayer, Tauri desktop app",
  "author": "sandraschi",
  "license": "MIT",
  "language": "python",
  "framework": "fastmcp",
  "type": "mcp_server",
  "status": "production",
  "transport": ["stdio", "http"],
  "keywords": ["games", "chess", "go", "shogi", "stockfish", "katago", "yaneuraou", "japanese", "kanji", "jlpt", "multiplayer", "tauri"],
  "categories": ["Entertainment", "Education", "Developer Tools"],
  "homepage": "https://github.com/sandraschi/games-app",
  "repository": {
    "url": "https://github.com/sandraschi/games-app",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "github",
      "identifier": "sandraschi/games-app",
      "transport": {
        "type": "stdio",
        "command": "uv",
        "args": ["run", "python", "-m", "games_mcp", "--mode", "stdio"]
      }
    },
    {
      "registryType": "github",
      "identifier": "sandraschi/games-app",
      "transport": {
        "type": "http",
        "url": "http://127.0.0.1:10987/mcp"
      }
    }
  ],
  "mcpServers": {
    "games-mcp": {
      "command": "uv",
      "args": ["run", "python", "-m", "games_mcp"],
      "capabilities": {
        "tools": { "enabled": true, "listChanged": true },
        "resources": { "enabled": true },
        "prompts": { "enabled": true },
        "skills": { "enabled": true },
        "webapp": {
          "enabled": true,
          "url": "http://127.0.0.1:10986",
          "api_url": "http://127.0.0.1:10987"
        }
      }
    }
  },
  "tools": [
    { "name": "new_game", "description": "Start a new correspondence game" },
    { "name": "make_move", "description": "Record a move in a game" },
    { "name": "get_game_state", "description": "Get current game state" },
    { "name": "join_shared_session", "description": "Join P2P Firebase session" },
    { "name": "get_ai_move", "description": "Request AI engine move" },
    { "name": "analyze_position_detailed", "description": "Deep position analysis" },
    { "name": "check_engine_health", "description": "Check AI engine status" },
    { "name": "create_tournament", "description": "Create a tournament" },
    { "name": "get_player_statistics", "description": "Player stats and ELO" },
    { "name": "update_player_rating", "description": "Update ELO rating" },
    { "name": "intelligent_game_analysis", "description": "Agentic game analysis" },
    { "name": "adaptive_learning_session", "description": "AI coaching session" },
    { "name": "design_coaching_program", "description": "Multi-week coaching plan" }
  ]
}

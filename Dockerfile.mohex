# MoHex Engine Docker Container
# Builds MoHex from source (Fuego + Benzene) and runs Python server wrapper

FROM ubuntu:22.04

RUN apt-get update && apt-get install -y \
    build-essential autoconf automake libtool g++ make \
    subversion git \
    libboost-all-dev libdb-dev \
    python3 python3-pip \
    curl && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Build Fuego (required by MoHex/Benzene)
RUN svn checkout -r 1371 http://svn.code.sf.net/p/fuego/code/trunk fuego \
    && cd fuego \
    && autoreconf -i \
    && ./configure \
    && make -j$(nproc)

RUN test -f /app/fuego/src/fuego/fuego || (echo "Fuego build failed" && exit 1)

# Build Benzene (includes MoHex)
RUN git clone https://github.com/cgao3/benzene.git benzene \
    && cd benzene \
    && autoreconf -i \
    && ./configure --with-fuego-root=/app/fuego \
    && make -j$(nproc)

RUN test -f /app/benzene/src/mohex/mohex || (echo "MoHex build failed" && exit 1)

COPY engines/mohex-server.py /app/engines/mohex-server.py

RUN pip3 install --no-cache-dir aiohttp aiohttp-cors

RUN echo '#!/bin/bash\n\
    export MOHEX_PATH=/app/benzene/src/mohex/mohex\n\
    export MOHEX_PORT=10775\n\
    exec python3 /app/engines/mohex-server.py --port 10775\n\
    ' > /app/start-mohex.sh && chmod +x /app/start-mohex.sh

EXPOSE 10775

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:10775/api/status || exit 1

CMD ["/app/start-mohex.sh"]
